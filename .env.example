# Copy to .env, fill in values, and restrict it to the account that runs cron:
# chmod 600 .env
# .env is loaded by scheduled scripts so they do not depend on a desktop keyring.
# Do not commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/financial_db
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
EXTERNAL_API_BASE=https://api.example.com
